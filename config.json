{
  "symbols": ["588330"],
  "timezone": "Asia/Shanghai",
  "trading_sessions": [
    ["09:15", "11:30"],
    ["13:00", "15:15"]
  ],
  "dry_run": false,
  "poll_seconds": 60,
  "portfolio": {
    "initial_cash": 50000
  },
  "risk": {
    "max_orders_per_day": 1,
    "require_manual_confirm": true,
    "allowed_symbols": ["588330"]
  },
  "execution": {
    "mode": "ths_applescript",
    "stage": "sim_run",
    "ths_account_mode": "simulation",
    "live_account_enabled": false,
    "simulation_allow_repeated_symbol_trades": false,
    "max_live_cash": 50000,
    "small_live_cash": 5000,
    "ths_app_name": "同花顺",
    "ths_bundle_id": "cn.com.10jqka.macstock",
    "ths_process_name": "同花顺",
    "ths_interaction_mode": "accessibility_first",
    "ths_visual_fallback_enabled": false,
    "ths_minimize_when_idle": true,
    "ths_app_ready_timeout_seconds": 30,
    "trade_password_env": "THS_TRADE_PASSWORD",
    "stage_cash_limits": {
      "dry_run": 50000,
      "gui_simulation": 50000,
      "sim_run": 50000,
      "small_live": 5000,
      "full_live": 50000
    },
    "require_screenshot_verification": true,
    "final_confirm_enabled": true,
    "price_tolerance": 0.001,
    "verification_fields_path": "screenshots/latest_verified_order.json",
    "order_verification_allowed_sources": ["applescript_vision_ocr"],
    "account_snapshot_path": "screenshots/latest_account_snapshot.json",
    "account_snapshot_max_age_seconds": 3600,
    "account_snapshot_allowed_sources": ["apple_vision_ocr"],
    "force_account_sync_on_app_open": true,
    "applescript_bridge_timeout_seconds": 180,
    "account_bridge_command": "",
    "gui_bridge_command": "python3 AppBridge_AppleScript.py --action order --app-name {app_name} --bundle-id {bundle_id} --process-name {process_name} --ready-timeout {ready_timeout_seconds} --interaction-mode {interaction_mode} {visual_fallback_flag} --intent {intent_path} --verification {verification_fields_path} {submit_flag}"
  },
  "notification": {
    "channel": "wechat_client",
    "wechat_recipient": ""
  },
  "runtime": {
    "trade_day_schedule_enabled": true,
    "stop_file": "STOP_TRADING",
    "state_file": "runtime_state.json",
    "screenshots_cleanup": {
      "enabled": true,
      "retention_days": 7,
      "max_files": 300,
      "keep_latest_files": true
    }
  },
  "backtest": {
    "commission_rate": 0.0003,
    "min_commission": 5,
    "stamp_tax_rate": 0,
    "slippage_bps": 2,
    "limit_threshold_pct": 0.195
  },
  "strategy": {
    "type": "trend_pullback",
    "buy_position_targets": [0.5, 0.85, 1.0],
    "max_position_ratio": 1.0,
    "sell_holding_ratio": 0.5,
    "stop_loss_ratio": 0.03,
    "profit_drawdown_ratio": 0.2,
    "clear_position_on_sell_count": 3,
    "lot_size": 100
  }
